{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // cmux reads ~/.config/ghostty/config for font, theme and terminal keys, so
  // this file holds only what cmux itself owns. A key set here wins over the
  // value saved in cmux's Settings window; remove it to hand control back.
  // Apply edits with `cmux reload-config` (⌘⇧,), no restart needed.

  "app": {
    // Open Folder starts where the projects live (T3 Code's Mac default too).
    "defaultWorkspacePath": "~/Developer",
    "sendAnonymousTelemetry": false
  },

  "browser": {
    // Links clicked or `open`ed in a terminal go to the real browser, which
    // has 1Password, the logins and the copy-url/yt-dlp extensions. The
    // embedded WebKit pane has none of them, and by default it also caught
    // lazygit's "open PR" and `gh ... --web`.
    "openTerminalLinksInCmuxBrowser": false,
    "interceptTerminalOpenCommandInCmuxBrowser": false
  },

  "sidebar": {
    // Same reason. Port links stay in the embedded browser: a localhost
    // preview needs no logins, and in a `cmux ssh` workspace cmux proxies it
    // through the remote host.
    "openPullRequestLinksInCmuxBrowser": false
  },

  "shortcuts": {
    "bindings": {
      // The default ⌃1-9 never reaches cmux: mac-wm gives ⌃1-9 to Mission
      // Control's Desktop switching (symbolic hotkeys 118-126).
      "selectSurfaceByNumber": "cmd+opt+1"
    }
  },

  // The fleet, one workspace per machine: open each once from the command
  // palette (⌘⇧P, type the name). cmux-fleet (~/.local/bin) holds the connect
  // commands; inside cmux it pins the workspace and registers itself as the
  // resume command, so the fleet stays in the sidebar across relaunches.
  // houston attaches its herdr server (herdr --remote; never tmux). nasa,
  // coolify and titan are plain logins, which the ssh() wrapper reconnects.
  // "ignore" switches to the workspace when it's already open.
  "commands": [
    {
      "name": "hermes",
      "description": "NASA Hermes chat with image paste",
      "keywords": ["agent", "homelab", "nasa", "images"],
      "restart": "ignore",
      "workspace": {
        "name": "hermes",
        "cwd": "~",
        "color": "Orange",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "browser",
                "name": "Hermes",
                "url": "https://nasa.tail55ddb6.ts.net:9119/chat",
                "focus": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "houston",
      "description": "Agent worker VM, its herdr server (herdr --remote)",
      "keywords": ["fleet", "ssh", "worker", "herdr"],
      "restart": "ignore",
      "workspace": {
        "name": "houston",
        "cwd": "~",
        "color": "Blue",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "type": "terminal",
                "name": "houston",
                "command": "cmux-fleet houston",
                "focus": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "nasa",
      "description": "Unraid NAS, root shell",
      "keywords": ["fleet", "ssh", "unraid"],
      "restart": "ignore",
      "workspace": {
        "name": "nasa",
        "cwd": "~",
        "color": "Teal",
        "layout": {
          "pane": {
            "surfaces": [
              { "type": "terminal", "name": "nasa", "command": "cmux-fleet nasa", "focus": true }
            ]
          }
        }
      }
    },
    {
      "name": "coolify",
      "description": "Hetzner VPS (production): ssh root@coolify for docker",
      "keywords": ["fleet", "ssh", "hetzner", "vps"],
      "restart": "ignore",
      "workspace": {
        "name": "coolify",
        "cwd": "~",
        "color": "Purple",
        "layout": {
          "pane": {
            "surfaces": [
              { "type": "terminal", "name": "coolify", "command": "cmux-fleet coolify", "focus": true }
            ]
          }
        }
      }
    },
    {
      "name": "titan",
      "description": "Windows gaming VM (cmd.exe)",
      "keywords": ["fleet", "ssh", "windows", "gaming"],
      "restart": "ignore",
      "workspace": {
        "name": "titan",
        "cwd": "~",
        "color": "Green",
        "layout": {
          "pane": {
            "surfaces": [
              { "type": "terminal", "name": "titan", "command": "cmux-fleet titan", "focus": true }
            ]
          }
        }
      }
    }
  ]
}
