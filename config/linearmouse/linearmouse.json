{
  "$schema": "https://schema.linearmouse.app/0.12.0",
  "schemes": [
    {
      "if": {
        "device": {
          "category": "mouse"
        }
      },
      "scrolling": {
        "reverse": true
      }
    },
    {
      "buttons": {
        "gesture": {
          "actions": {
            "down": "appExpose",
            "left": "missionControl.spaceLeft",
            "right": "missionControl.spaceRight",
            "up": "missionControl"
          },
          "enabled": true,
          "threshold": 50,
          "trigger": {
            "button": {
              "controlID": 195,
              "kind": "logitechControl",
              "productID": 45108,
              "serialNumber": "AD13154F"
            },
            "command": false,
            "control": false,
            "option": false,
            "shift": false
          }
        },
        "mappings": [
          {
            "outcomes": {
              "shortPress": "missionControl"
            },
            "trigger": {
              "input": {
                "button": {
                  "controlID": 195,
                  "kind": "logitechControl",
                  "productID": 45108,
                  "serialNumber": "AD13154F"
                }
              }
            }
          }
        ],
        "universalBackForward": true
      },
      "if": {
        "device": {
          "category": "mouse",
          "productID": "0xb034",
          "productName": "MX Master 3S",
          "serialNumber": "AD13154F",
          "vendorID": "0x46d"
        }
      },
      "logitech": {
        "highResolutionWheel": true
      },
      "scrolling": {
        "reverse": {
          "vertical": true,
          "horizontal": true
        },
        "modifiers": {
          "shift": {
            "type": "alterOrientation"
          },
          "option": {
            "type": "pinchZoom"
          }
        }
      }
    }
  ]
}
