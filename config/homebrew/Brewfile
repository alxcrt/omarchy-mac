# ~/.config/homebrew/Brewfile
# Declarative source of truth for Homebrew's layer (system + GUI apps).
# Apply / reconcile with:  brew bundle --file=~/.config/homebrew/Brewfile
# Dev tooling + AI CLIs are deliberately NOT here — those live in mise
# (~/.config/mise/config.toml). One package manager per layer, no overlap.

# --- Third-party taps ---
# Homebrew 6 refuses to load formulae from untrusted taps and aborts the whole
# bundle, so install.sh trusts each one first (brew trust --formula ...).
tap "bjarneo/cliamp"
tap "blacktop/tap"
tap "mateussiqueira/unleash"

# --- CLI: Omarchy's pacman set, ported ---
brew "git"          # direct binary: /usr/bin/git is an xcrun stub that adds ~10ms per call
brew "bat"          # cat with syntax highlighting; used as MANPAGER
brew "eza"          # ls replacement, aliased over ls
brew "fd"
brew "fzf"
brew "ripgrep"
brew "zoxide"       # aliased over cd
brew "jq"
brew "gum"          # confirm prompt in gd (functions.zsh)
brew "try"          # tobi/try experiment dirs (upstream init; lazy-loaded in zshrc)
brew "fswatch"      # rsw: macOS file-event watcher (upstream uses inotifywait)
brew "terminal-notifier"  # clickable notifications (mac-notify); osascript's open Script Editor
brew "bjarneo/cliamp/cliamp"  # Omarchy's music TUI (upstream base package)
brew "btop"
brew "fastfetch"
brew "starship"
brew "neovim"
brew "lazygit"
brew "lazydocker"
brew "dua-cli"
brew "tlrc"         # tldr
brew "yt-dlp"
brew "imagemagick"
brew "ffmpeg"
brew "gifski"       # high-quality GIF encoder (Omarchy 3.8 gif transcoding)
brew "wget"
brew "mise"         # dev-tooling layer manager
brew "pam-reattach"  # Touch ID for sudo inside herdr (or any detached session)
brew "mas"          # Mac App Store CLI — used by `macup`
brew "coreutils"    # GNU coreutils; some scripts assume GNU flags
brew "gnu-sed"
brew "findutils"

# --- CLI already on this machine (kept) ---
brew "fx"
brew "hf"
brew "just"
brew "llama.cpp"
brew "mole"
brew "openai-whisper"
brew "whisper-cpp"
brew "xh"

# --- CLI installed by hand, declared Oct 2026 ---
brew "duti"         # set default apps for file types / URL schemes
brew "expat"        # XML parser library (keg-only; macOS ships its own)
brew "megatools"    # mega.nz command-line client
brew "rom-tools"    # MAME ROM tools (chdman: .chd images)
brew "radare2"      # reverse-engineering framework (iOS RE skill)
brew "blacktop/tap/ipsw"  # iOS firmware / Mach-O analysis (iOS RE skill)
brew "ipatool"      # search and download IPAs from the App Store
brew "xcodegen"     # generate Xcode projects from a spec
brew "chafa"        # images in the terminal
brew "cloc"         # count lines of code
brew "exiftool"     # read/write photo and video metadata
brew "lesspipe"     # rich previews in less (LESSOPEN, ~/.zshrc.local)
brew "libpq"        # Postgres client library and psql
brew "p7zip"        # .7z archives
brew "pngquant"     # lossy PNG compression
brew "poppler"      # PDF tools (pdftotext, pdftoppm)
brew "postgresql@18"  # nl-lms database (brew services)
brew "redis"        # nl-lms cache; runs as a login service (brew services)
brew "smartmontools"  # disk health (smartctl)
brew "tree"
brew "mateussiqueira/unleash/unleash"

# --- GUI casks ---
cask "ghostty@tip"             # terminal (tip builds)
cask "google-chrome"           # primary browser (Phase 7 webapp target)
cask "helium-browser"          # Helium (ungoogled Chromium); not "helium", an unrelated Gatekeeper-disabled Intel app
cask "iina"                    # media player (macOS-native mpv)
cask "localsend"
cask "tailscale-app"           # mesh VPN (menu-bar app; ships its own CLI)
cask "transmission"            # replaced qbittorrent (Gatekeeper-deprecated, disabled 2026-09-01)
cask "raycast"                 # launcher
# cursor NOT a cask here: installed root-owned and self-updating, so every
# greedy upgrade dies on "Permission denied .../Cursor.app/Contents/
# CodeResources". Same story as google-chrome below. Install manually once.
cask "visual-studio-code"
cask "cmux"
cask "t3-code@nightly"        # T3 Code (Nightly) — minimal GUI for AI code agents
cask "cleanshot"
cask "ollama-app"
cask "obsidian"
cask "chatgpt"                 # ChatGPT desktop app (Omarchy 4 Install > AI)
cask "claude"                  # Claude desktop app
# 1password NOT a cask here: same root-owned self-updater problem as cursor.
cask "1password-cli"
cask "moonlight"
cask "steam"
cask "docker-desktop"          # installed (needs admin password on install)
cask "font-jetbrains-mono-nerd-font"
cask "font-ia-writer-duo"

