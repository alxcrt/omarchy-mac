# --- GUI casks ---
cask "ghostty@tip"             # terminal (tip builds)
cask "google-chrome"           # primary browser (Phase 7 webapp target)
cask "helium-browser"          # Helium (ungoogled Chromium); not "helium", an unrelated Gatekeeper-disabled Intel app
cask "iina"                    # media player (macOS-native mpv)
cask "localsend"
cask "tailscale-app"           # mesh VPN (menu-bar app; ships its own CLI)
cask "transmission"            # replaced qbittorrent (Gatekeeper-deprecated, disabled 2026-09-01)
cask "raycast"                 # launcher
# cursor NOT a cask here: installed root-owned and self-updating, so every
# greedy upgrade dies on "Permission denied .../Cursor.app/Contents/
# CodeResources". Same story as google-chrome below. Install manually once.
cask "visual-studio-code"
cask "cmux"
cask "t3-code@nightly"        # T3 Code (Nightly) — minimal GUI for AI code agents
cask "cleanshot"
cask "ollama-app"
cask "obsidian"
cask "chatgpt"                 # ChatGPT desktop app (Omarchy 4 Install > AI)
cask "claude"                  # Claude desktop app
# 1password NOT a cask here: same root-owned self-updater problem as cursor.
cask "1password-cli"
cask "moonlight"
cask "steam"
cask "docker-desktop"          # installed (needs admin password on install)
cask "font-jetbrains-mono-nerd-font"
cask "font-ia-writer-duo"

