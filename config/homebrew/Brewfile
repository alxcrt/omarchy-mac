# ~/.config/homebrew/Brewfile
# Declarative source of truth for Homebrew's layer (system + GUI apps).
# Apply / reconcile with:  brew bundle --file=~/.config/homebrew/Brewfile
# Dev tooling + AI CLIs are deliberately NOT here — those live in mise
# (~/.config/mise/config.toml). One package manager per layer, no overlap.

# --- CLI: Omarchy's pacman set, ported ---
brew "bat"          # cat with syntax highlighting; used as MANPAGER
brew "eza"          # ls replacement, aliased over ls
brew "fd"
brew "fzf"
brew "ripgrep"
brew "zoxide"       # aliased over cd
brew "jq"
brew "gum"          # confirm prompt in gd (functions.zsh)
brew "btop"
brew "fastfetch"
brew "starship"
brew "tmux"
brew "neovim"
brew "lazygit"
brew "lazydocker"
brew "dua-cli"
brew "tlrc"         # tldr
brew "yt-dlp"
brew "imagemagick"
brew "ffmpeg"
brew "gifski"       # high-quality GIF encoder (Omarchy 3.8 gif transcoding)
brew "wget"
brew "mise"         # dev-tooling layer manager
brew "pam-reattach"  # Touch ID for sudo inside tmux
brew "mas"          # Mac App Store CLI — used by `macup`
brew "coreutils"    # GNU coreutils; some scripts assume GNU flags
brew "gnu-sed"
brew "findutils"

