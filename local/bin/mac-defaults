#!/bin/bash
# mac-defaults — the macOS preferences this setup sets, in one list.
#
#   mac-defaults [--status]   each setting: wanted vs. current (exit 1 on drift)
#   mac-defaults --apply      write them; restart Finder/Dock only if they changed
#
# Key repeat is read at login: apps opened before a logout keep the old rate.
# Transmission and Docker Desktop read their prefs at launch; --apply never
# quits them, since that would cut off running downloads and containers.
set -e

# domain|key|type|value|what it does   (a leading ~ in either is $HOME)
#   A domain ending in .json is an app's JSON settings file (plutil edits it).
#   InitialKeyRepeat 15 is the shortest delay the Settings slider allows;
#   KeyRepeat 1 is faster than its fastest stop (2).
#   autohide is on so the two Dock timings have something to speed up.
SETTINGS='-g|InitialKeyRepeat|int|15|short delay before key repeat
-g|KeyRepeat|int|1|fastest key repeat
com.apple.finder|AppleShowAllFiles|bool|true|Finder shows hidden files
com.apple.finder|ShowPathbar|bool|true|Finder shows the full path at the bottom
com.apple.finder|ShowStatusBar|bool|true|Finder shows item count and free disk space
com.apple.dock|autohide|bool|true|Dock hides itself
com.apple.dock|autohide-delay|float|0|Dock shows with no delay
com.apple.dock|autohide-time-modifier|int|0|Dock hides/shows with no animation
org.m0k.transmission|DownloadLocationConstant|bool|true|Transmission saves to one fixed folder
org.m0k.transmission|DownloadFolder|string|~/Downloads|Transmission saves to ~/Downloads
org.m0k.transmission|WarningDonate|bool|false|Transmission never asks for donations
org.m0k.transmission|WarningLegal|bool|false|Transmission skips its legal notice
~/Library/Group Containers/group.com.docker/settings-store.json|MemoryMiB|int|4096|Docker VM capped at 4 GB (default 8)'

# Default apps, set with duti (from the Brewfile).
# bundle id|URL scheme, or .extension for a file type|what it does
HANDLERS='org.m0k.transmission|magnet|magnet links open in Transmission
org.m0k.transmission|.torrent|.torrent files open in Transmission'

# `defaults read` prints booleans as 1/0
readback() { case "$1|$2" in bool\|true) echo 1 ;; bool\|false) echo 0 ;; *) echo "${2/#\~/$HOME}" ;; esac; }
current()  {
  case "$1" in
    *.json) plutil -extract "$2" raw -o - "${1/#\~/$HOME}" 2>/dev/null || echo "(unset)" ;;
    *) defaults read "$1" "$2" 2>/dev/null || echo "(unset)" ;;
  esac
}
# `duti -x ext` prints the app's name, path and bundle id, one per line.
handler()  { case "$1" in .*) duti -x "${1#.}" 2>/dev/null | sed -n 3p ;; *) duti -d "$1" 2>/dev/null || true ;; esac; }

status() {
  local drift=0 domain key type value desc now want bundle target
  while IFS='|' read -r domain key type value desc; do
    now=$(current "$domain" "$key"); want=$(readback "$type" "$value")
    if [ "$now" = "$want" ]; then
      printf '  ✓ %-24s %s\n' "$key" "$desc"
    else
      printf '  ✗ %-24s %s (is %s, want %s)\n' "$key" "$desc" "$now" "$want"; drift=1
    fi
  done <<<"$SETTINGS"
  if command -v duti >/dev/null; then
    while IFS='|' read -r bundle target desc; do
      now=$(handler "$target")
      if [ "$now" = "$bundle" ]; then
        printf '  ✓ %-24s %s\n' "$target" "$desc"
      else
        printf '  ✗ %-24s %s (is %s)\n' "$target" "$desc" "${now:-(unset)}"; drift=1
      fi
    done <<<"$HANDLERS"
  else
    echo "  ✗ duti missing, so default apps can't be checked (brew bundle)"; drift=1
  fi
  [ -d "$HOME/Developer" ] && echo "  ✓ ~/Developer exists" || { echo "  ✗ ~/Developer missing"; drift=1; }
  return $drift
}

apply() {
  local domain key type value desc restart=() bundle target role
  while IFS='|' read -r domain key type value desc; do
    [ "$(current "$domain" "$key")" = "$(readback "$type" "$value")" ] && continue
    value=${value/#\~/$HOME}
    case "$domain" in
      *.json) # The app writes this file on first launch; until then, skip it.
        plutil -replace "$key" "-${type/#int/integer}" "$value" "${domain/#\~/$HOME}" 2>/dev/null \
          || { echo "skipped $key: ${domain##*/} doesn't exist yet (open the app once)"; continue; } ;;
      *) defaults write "$domain" "$key" "-$type" "$value" ;;
    esac
    echo "set $key = $value ($desc)"
    case "$domain" in com.apple.finder) restart+=(Finder) ;; com.apple.dock) restart+=(Dock) ;; esac
  done <<<"$SETTINGS"
  if command -v duti >/dev/null; then
    while IFS='|' read -r bundle target desc; do
      [ "$(handler "$target")" = "$bundle" ] && continue
      # A file type needs a role; `all` covers viewer and editor.
      case "$target" in .*) role=all ;; *) role= ;; esac
      if duti -s "$bundle" "$target" $role 2>/dev/null; then
        echo "set $target → $bundle ($desc)"
      else
        echo "skipped $target: $bundle is not installed yet"
      fi
    done <<<"$HANDLERS"
  else
    echo "skipped default apps: duti is not installed yet (brew bundle)"
  fi
  # Finder gives ~/Developer its own folder icon.
  mkdir -p "$HOME/Developer"
  if [ ${#restart[@]} -gt 0 ]; then
    killall $(printf '%s\n' "${restart[@]}" | sort -u) 2>/dev/null || true
  fi
  echo "macOS defaults applied"
}

case "${1:---status}" in
  --status) status ;;
  --apply)  apply ;;
  *) echo "usage: mac-defaults [--status|--apply]" >&2; exit 1 ;;
esac
