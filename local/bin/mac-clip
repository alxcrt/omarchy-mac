#!/bin/bash
# mac-clip [--share] <file> — put a file on the clipboard the way Finder's ⌘C
# does, so ⌘V pastes the file itself (into Finder, Messages, WhatsApp, Slack…),
# not its path. pbcopy only carries text; this writes a file URL to
# NSPasteboard through JavaScript for Automation, which ships with macOS.
# Prints the path that went on the clipboard.
#
#   --share  for a video, copy a share-ready version instead: <name>-share.mp4
#            from `transcode <file> mp4 share` (made once, then reused).
#
# MAC_CLIP_PASTEBOARD=<name> writes to a private named pasteboard instead of
# the general one (tests use it so they never clobber the real clipboard).
# MAC_CLIP_COUNT_FILE=<file> receives the pasteboard change count of THIS
# write (returned by the write itself), so a test can tell its own write from
# anything copied a moment later.

share=0; [ "${1:-}" = --share ] && { share=1; shift; }
f=${1:?usage: mac-clip [--share] <file>}
[ -e "$f" ] || { echo "mac-clip: no such file: $f" >&2; exit 1; }
abs="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"

if [ $share = 1 ]; then
  case $abs in
    *-share.mp4) ;;   # already the share copy
    *.[mM][pP]4|*.[mM][oO][vV]|*.[mM]4[vV]|*.[mM][kK][vV]|*.[wW][eE][bB][mM])
      s="${abs%.*}-share.mp4"
      if [ ! -s "$s" ] || [ "$abs" -nt "$s" ]; then
        s=$("$HOME/.local/bin/transcode" "$abs" mp4 share | tail -1) && [ -s "$s" ] ||
          { echo "mac-clip: could not make a share copy of $abs" >&2; exit 1; }
      fi
      abs=$s ;;
  esac
fi

# declareTypes + setString/setPropertyList, NOT writeObjects: data handed over
# by writeObjects from a process that exits straight away was dropped 4 times
# in 5 (Oct 2026) — "Copied" was announced and the clipboard was empty. These
# setters are synchronous, like pbcopy's. Both the modern file URL and the
# legacy filename list are written, as Finder's ⌘C provides both.
osascript -l JavaScript - "$abs" "${MAC_CLIP_PASTEBOARD:-}" "${MAC_CLIP_COUNT_FILE:-}" >/dev/null <<'JXA' || exit 1
ObjC.import("AppKit");
function run(argv) {
  const pb = argv[1] ? $.NSPasteboard.pasteboardWithName(argv[1])
                     : $.NSPasteboard.generalPasteboard;
  const count = pb.declareTypesOwner($(["public.file-url", "NSFilenamesPboardType"]), null);
  const ok = pb.setStringForType($.NSURL.fileURLWithPath(argv[0]).absoluteString, "public.file-url")
          && pb.setPropertyListForType($([argv[0]]), "NSFilenamesPboardType");
  if (!ok) throw new Error("pasteboard write failed");
  // writeToFile returns false instead of throwing: a count that wasn't
  // recorded must fail the run, so a caller never reads a stale one.
  if (argv[2] && !$(String(count)).writeToFileAtomicallyEncodingError(argv[2], true, $.NSUTF8StringEncoding, null))
    throw new Error("could not record the change count in " + argv[2]);
}
JXA
echo "$abs"
