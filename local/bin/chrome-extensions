#!/bin/bash
# chrome-extensions — manage Omarchy's browser extensions on macOS.
#
# Omarchy loads these with Chromium's --load-extension (config/chromium-flags.conf).
# macOS Chrome offers two routes and no third: a one-time "Load unpacked" that
# persists, or --load-extension supplied on every launch. Extensions cannot be
# injected into an existing profile — Chrome HMAC-validates Secure Preferences
# and reverts anything written behind its back.
#
#   chrome-extensions           list what's staged
#   chrome-extensions verify    check whether Chrome has actually loaded them
#   chrome-extensions install   open the Load-unpacked UI + reveal the folders
#   chrome-extensions relaunch  quit Chrome and reopen it with --load-extension
set -e

EXT_DIR="$HOME/.config/omarchy-mac/extensions"
NMH="$HOME/Library/Application Support/Google/Chrome/NativeMessagingHosts"
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
CHROME_DIR="$HOME/Library/Application Support/Google/Chrome"

ext_paths() {
  local out=""
  for d in "$EXT_DIR"/*/; do [ -d "$d" ] && out="${out:+$out,}${d%/}"; done
  printf '%s' "$out"
}

case "${1:-list}" in
  list)
    echo "Staged in $EXT_DIR:"
    for d in "$EXT_DIR"/*/; do
      [ -d "$d" ] || continue
      python3 - "$d" <<'PY'
import json,sys,os
d=sys.argv[1]
m=json.load(open(os.path.join(d,"manifest.json")))
cmds=m.get("commands",{})
keys=", ".join(v.get("suggested_key",{}).get("default","") for v in cmds.values()) or "-"
print(f"  {os.path.basename(d.rstrip('/')):<16}{m['name']:<18}shortcut: {keys}")
PY
    done
    echo
    echo "Native messaging hosts:"
    for f in "$NMH"/com.omarchy.*.json; do [ -f "$f" ] && echo "  ✓ $(basename "$f")"; done
    ;;

  verify)
    # Look through every Chrome profile for our extension IDs.
    python3 - "$CHROME_DIR" <<'PY'
import json,os,sys
root=sys.argv[1]
want={"dedjgknigfeelejglamclffonmophnfl":"Download Video",
      "bgpiichlckmfanooecilcjemknkcpngb":"Copy URL"}
found={}
for prof in os.listdir(root):
    p=os.path.join(root,prof,"Preferences")
    if not os.path.exists(p): continue
    try: d=json.load(open(p))
    except Exception: continue
    for eid,v in (d.get("extensions",{}).get("settings",{}) or {}).items():
        name=((v.get("manifest") or {}).get("name")) or ""
        if eid in want or "Download Video" in name or "Copy URL" in name or "WhatsApp Slim" in name:
            found.setdefault(prof,[]).append(f"{name or eid}")
if found:
    for prof,names in found.items():
        print(f"  LOADED in {prof}: {', '.join(names)}")
    print("STATUS=loaded")
else:
    print("STATUS=not-loaded")
    print("  NOT LOADED in any profile.")
    print("  Chrome writes Preferences on exit — if you just loaded them,")
    print("  quit Chrome once and re-run `chrome-extensions verify`.")
PY
    ;;

  install)
    echo "One-time load (persists across restarts):"
    echo "  1. chrome://extensions opens now — enable 'Developer mode' (top right)"
    echo "  2. Click 'Load unpacked' once per folder in the Finder window:"
    for d in "$EXT_DIR"/*/; do echo "       $(basename "${d%/}")"; done
    echo "  3. Confirm with: chrome-extensions verify"
    echo
    echo "If a shortcut doesn't bind, set it at chrome://extensions/shortcuts"
    open -a "Google Chrome" "chrome://extensions/" 2>/dev/null || true
    open "$EXT_DIR" 2>/dev/null || true
    ;;

  relaunch)
    # Omarchy's approach: pass --load-extension at launch. Chrome must restart,
    # and the flag has to be supplied every time (this command does that).
    echo "Quitting Chrome (tabs are restored on reopen)…"
    osascript -e 'tell application "Google Chrome" to quit' 2>/dev/null || true
    sleep 3
    echo "Relaunching with --load-extension…"
    "$CHROME" --load-extension="$(ext_paths)" --restore-last-session >/dev/null 2>&1 &
    sleep 5
    echo "Done. Verify with: chrome-extensions verify"
    ;;

  *) echo "Usage: chrome-extensions [list|verify|install|relaunch]"; exit 1 ;;
esac
