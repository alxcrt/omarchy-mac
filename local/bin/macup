#!/bin/bash
# macup — one command to update everything. Port of `omarchy update`.
#
# No `set -e`: one failing layer (a cask whose installer needs sudo, a flaky
# mise download) must not skip the rest. Each step's failure is recorded and
# reported at the end, and the exit status says whether anything failed.

section() { echo -e "\n\033[0;32m$1\033[0m"; }
FAILED=()
NEEDS_YOU=()   # not failures: things only a human can fix, reported at the end
step() { "$@" || FAILED+=("$*"); }

# One macup at a time (upstream: "An Omarchy update is already running").
# Two at once collide on brew's download locks and both fail spuriously.
# mkdir is the atomic test-and-set (macOS has no flock); a lock left by a run
# that died is taken over.
LOCK="${XDG_STATE_HOME:-$HOME/.local/state}/macup/lock"
mkdir -p "${LOCK%/*}"
# Ownership = pid + that process's start time, so a pid reused by an
# unrelated process after a crash or reboot does not look like a live run.
pstart() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed 's/^ //; s/ $//'; }
me="$$ $(pstart $$)"
lock_owner_alive() {
  local pid start
  read -r pid start <"$LOCK/owner" 2>/dev/null || return 1
  [ -n "$pid" ] && [ "$(pstart "$pid")" = "$start" ]
}
if ! mkdir "$LOCK" 2>/dev/null; then
  # A lock under a minute old with no owner yet is a run that is starting up:
  # it is live, not stale (deleting it would let both runs go ahead).
  if [ ! -e "$LOCK/owner" ] && [ -z "$(find "$LOCK" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
    echo "macup is already starting." >&2; exit 1
  fi
  if lock_owner_alive; then
    echo "macup is already running (pid $(cut -d' ' -f1 "$LOCK/owner"))." >&2; exit 1
  fi
  # Stale. Rename it away before deleting: only one of several takers can win
  # the rename, and the losers then fail the mkdir below.
  mv "$LOCK" "$LOCK.stale.$$" 2>/dev/null && rm -rf "$LOCK.stale.$$"
  mkdir "$LOCK" 2>/dev/null || { echo "macup: another run took the lock." >&2; exit 1; }
fi
echo "$me" >"$LOCK/owner"

# Stay awake while updating (upstream does the same); ends with this process.
caffeinate -i -w $$ >/dev/null 2>&1 &

# Stale symlinks mean you're running old copies of these scripts/configs
# (that's how an old macup without --yes kept prompting). Warn; don't auto-fix,
# since relinking replaces whatever local edits the copy holds.
if [ ! -L "$HOME/.local/bin/macup" ] || [ ! -L "$HOME/.config/mise/config.toml" ]; then
  echo -e "\033[0;33mwarning: live configs are copies, not repo symlinks — run ~/omarchy-mac/install.sh --links\033[0m"
fi

# softwareupdate --list takes 10-30s of network round-trips; start it now and
# read the result at the end instead of waiting on it serially.
# Release the lock only while it is still ours.
SWU=$(mktemp); trap 'rm -f "$SWU"; [ "$(cat "$LOCK/owner" 2>/dev/null)" = "$me" ] && rm -rf "$LOCK"' EXIT
softwareupdate --list >"$SWU" 2>&1 &
SWU_PID=$!

section "Homebrew"
step brew update --quiet
# One upgrade call for formulae and casks: a single dependency resolve instead
# of two. --greedy also catches casks that self-update, so they don't drift.
# --yes: Homebrew 6+ asks y/n before every upgrade by default.
step brew upgrade --greedy --yes

section "Mac App Store"
# Two traps, both hit on this Mac:
#  - `mas update` needs root (mas 2+). Authenticate once up front so sudo can
#    use Touch ID (pam_tid) instead of mas's own password prompt; with no
#    terminal to ask in, skip rather than hang.
#  - An app owned by a DIFFERENT Apple Account (Developer and TestFlight were)
#    can never be updated from this one. Every attempt pops a modal
#    "Redownload Unavailable with This Apple Account" dialog and mas prints
#    "No downloads initiated for ADAM ID <id>". Remember those IDs, keyed to
#    the app's receipt, and skip them: the dialog shows once, not every run,
#    and a reinstall (new receipt) clears the entry by itself.
MAS_SKIP="${XDG_STATE_HOME:-$HOME/.local/state}/macup/mas-skip"
receipt_stamp() {
  local app; app=$(mdfind "kMDItemAppStoreAdamID == $1" 2>/dev/null | head -1)
  stat -f %m "$app/Contents/_MASReceipt/receipt" 2>/dev/null || echo 0
}
foreign_app() {
  NEEDS_YOU+=("$2 ($1) belongs to another Apple Account; reinstall it under yours: mas uninstall $1 && mas get $1")
}
app_store() {
  command -v mas >/dev/null || { echo "mas not installed, skipping"; return; }
  local outdated id todo=() out rc known
  # Lines look like: "640199958  Developer   (11.0.2 -> 11.1)"
  outdated=$(mas outdated 2>/dev/null)
  # /bin/bash is 3.2 on macOS: no associative arrays, so look names up here.
  name_of() { awk -v id="$1" '$1 == id { $1 = ""; sub(/^ +/, ""); sub(/ *\(.*$/, ""); print }' <<<"$outdated"; }
  [ -n "$outdated" ] || { echo "Everything up to date"; return; }
  mkdir -p "${MAS_SKIP%/*}" && touch "$MAS_SKIP"
  for id in $(awk '{print $1}' <<<"$outdated"); do
    if grep -qx "$id $(receipt_stamp "$id")" "$MAS_SKIP"; then
      foreign_app "$id" "$(name_of "$id")"
    else
      todo+=("$id")
    fi
  done
  [ ${#todo[@]} -gt 0 ] || { echo "Nothing mas can update"; return; }

  if ! sudo -n true 2>/dev/null; then
    if [ -t 0 ]; then
      sudo -v || { FAILED+=("mas update (sudo declined)"); return; }
    else
      NEEDS_YOU+=("${#todo[@]} App Store update(s) need sudo; run macup from a terminal")
      return
    fi
  fi
  out=$(mas update "${todo[@]}" 2>&1); rc=$?
  [ -n "$out" ] && echo "$out"
  for id in $(grep -oE 'No downloads initiated for ADAM ID [0-9]+' <<<"$out" | awk '{print $NF}'); do
    echo "$id $(receipt_stamp "$id")" >>"$MAS_SKIP"
    foreign_app "$id" "$(name_of "$id")"
  done
  # Any other error is a real failure, and so is a nonzero exit with no
  # recognisable cause.
  known=$(grep -c 'No downloads initiated' <<<"$out")
  if [ $rc -ne 0 ] && { [ "$known" -eq 0 ] || grep -v 'No downloads initiated' <<<"$out" | grep -q '^Error'; }; then
    FAILED+=("mas update")
  fi
}
app_store

section "mise tools"
# Same override as the `mup` alias: mise withholds releases younger than its
# cooldown window, which leaves the AI CLIs (claude/codex/gh) days behind.
# Runs after brew, never alongside it: mise downloads fail with "address not
# available" while brew saturates the network.
# `mise up` only upgrades what is already installed, so install anything newly
# declared in config.toml first (a no-op when nothing is missing).
step mise install
step mise up

section "Cleanup"
step brew cleanup -s --prune=all
step brew autoremove
# Old mise tool versions. mise's own auto-prune is off (upgrade.auto_prune):
# it deleted versions out from under day-old claude/codex sessions. Prune
# here, keeping any version a running process has open. lsof reports real
# paths, so a session started through installs/<tool>/latest still counts.
prune_mise() {
  local opened tool ver path
  # Every executable mapped by a running process, as full paths (lsof's n
  # records; spaces in a path survive). An empty list means "unknown", not
  # "nothing in use": pruning then would delete live sessions' binaries.
  opened=$(lsof -n -Fn -d txt 2>/dev/null | sed -n 's/^n//p')
  if [ -z "$opened" ]; then
    echo "skipping prune: could not list running executables (lsof)"
    return
  fi
  mise ls --prunable --json 2>/dev/null |
    jq -r 'to_entries[] | .key as $t | .value[] | select(.installed) | [$t, .version, .install_path] | @tsv' |
    while IFS=$'\t' read -r tool ver path; do
      [ -n "$path" ] || continue
      if grep -qF -- "$path/" <<<"$opened"; then
        echo "keeping $tool@$ver (in use)"
      else
        mise uninstall "$tool@$ver" >/dev/null 2>&1 && echo "pruned $tool@$ver"
      fi
    done
}
prune_mise

section "Status"
# brew doctor is slow and its warnings rarely actionable after an update;
# `mac doctor` runs it on demand. mise doctor is fast and catches PATH breakage.
mise doctor >/dev/null 2>&1 || echo "mise doctor reports problems — run: mise doctor"
# Report available macOS updates — never auto-install them.
wait "$SWU_PID"
grep -q 'No new software available' "$SWU" && echo "macOS up to date" || tail -5 "$SWU"

# User hooks (port of omarchy's hook system) — see ~/.config/omarchy-mac/hooks/
command -v mac-hook >/dev/null && mac-hook post-update

if [ ${#NEEDS_YOU[@]} -gt 0 ]; then
  echo -e "\n\033[0;33mNeeds you:\033[0m"; printf '  %s\n' "${NEEDS_YOU[@]}"
fi
if [ ${#FAILED[@]} -gt 0 ]; then
  echo -e "\n\033[0;31mFailed:\033[0m"; printf '  %s\n' "${FAILED[@]}"
  exit 1
fi
[ ${#NEEDS_YOU[@]} -gt 0 ] && echo -e "\n\033[0;32mDone.\033[0m" || echo -e "\n\033[0;32mAll up to date.\033[0m"
