#!/bin/bash
# macup — one command to update everything. Port of `omarchy update`.
set -e

section() { echo -e "\n\033[0;32m$1\033[0m"; }

section "Homebrew formulae"
brew update
# --yes: Homebrew 6 defaults to asking before every upgrade, which would
# stall this unattended flow at a y/n prompt.
brew upgrade --yes

section "Homebrew casks"
# --greedy also catches apps that self-update, so they don't drift.
brew upgrade --cask --greedy --yes

section "Mac App Store"
if command -v mas >/dev/null; then
  # Apple's own bundled apps (GarageBand, iMovie) always fail here with
  # "No downloads initiated" — mas cannot drive their delivery mechanism.
  # Report it honestly instead of claiming mas is missing, and don't abort.
  mas upgrade || echo "mas: some apps were not upgraded (Apple's bundled apps update via the App Store app itself)"
else
  echo "mas not installed, skipping"
fi

section "mise tools"
# Same override as the `mup` alias: mise withholds releases younger than its
# cooldown window, which leaves the AI CLIs (claude/codex/gh) days behind.
# Asking to update means now.
MISE_MINIMUM_RELEASE_AGE=0 mise up

section "Cleanup"
brew cleanup -s
brew autoremove

section "Status"
brew doctor || true
mise doctor || true
# Report available macOS updates — never auto-install them.
softwareupdate --list 2>&1 | tail -5

# User hooks (port of omarchy's hook system) — see ~/.config/omarchy-mac/hooks/
command -v mac-hook >/dev/null && mac-hook post-update || true
