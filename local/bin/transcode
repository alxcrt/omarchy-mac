#!/bin/bash
# transcode <file> <format> <quality> — macOS port of omarchy-transcode.
# Uses ffmpeg / imagemagick / gifski (all already installed via Homebrew).
#
#   transcode clip.mov mp4 1080p
#   transcode clip.mov mp4 4k
#   transcode clip.webm mp4 share   (H.264/AAC copy that every chat app plays)
#   transcode clip.mov gif 1080p
#   transcode shot.png jpg high|medium|low
#   transcode shot.jpg png high
#
# Output is written next to the input as <name>-<quality>.<format>.
set -e

# No args: fall back to the interactive picker, matching upstream
# omarchy-transcode's no-argument behaviour.
if [[ $# -eq 0 ]]; then
  exec "$(dirname "$0")/transcode-pick"
fi

file=$1; format=$2; quality=${3:-high}
[[ -z $file || -z $format ]] && {
  echo "Usage: transcode <file> <mp4|gif|jpg|png> [quality]"; exit 1; }
[[ -f $file ]] || { echo "No such file: $file"; exit 1; }

# Split dir/name first: "${file%.*}" strips the last dot-segment of the WHOLE
# path, so "My.Project/clip" produced "My-720p.mp4" one level up, and "./video"
# produced an empty base that ffmpeg read as a flag.
dir=$(dirname "$file"); name=$(basename "$file")
base="${name%.*}"
out="$dir/${base}-${quality}.${format}"

case "$format" in
  mp4)
    if [[ $quality == share ]]; then
      # share: a copy Messenger, WhatsApp, Teams and Instagram all play inline.
      # yt-dlp often saves AV1/VP9 video with Opus audio inside the .mp4, which
      # many of those clients refuse. Target H.264 + AAC, yuv420p, short side
      # at most 1080 (never upscaled), and the index up front (+faststart) so
      # previews stream. Streams that already comply are copied untouched;
      # the rest encode on the Apple Silicon media engine (h264_videotoolbox,
      # constant quality), which takes seconds, not minutes.
      # key=value, not csv: ffprobe prints fields in its own order (codec,
      # width, height, pix_fmt), whatever order -show_entries asks for.
      while IFS== read -r k v; do
        case $k in codec_name) vcodec=$v ;; pix_fmt) pixfmt=$v ;; width) w=$v ;; height) h=$v ;; esac
      done < <(ffprobe -v error -select_streams v:0 \
        -show_entries stream=codec_name,pix_fmt,width,height -of default=nw=1 "$file")
      acodec=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of csv=p=0 "$file")
      short=$(( w < h ? w : h ))
      if [[ $vcodec == h264 && $pixfmt == yuv420p && $short -le 1080 ]]; then
        vargs=(-c:v copy)
      else
        vargs=(-vf "scale='if(gte(iw,ih),-2,min(1080,iw))':'if(gte(iw,ih),min(1080,ih),-2)'"
               -c:v h264_videotoolbox -q:v 60 -profile:v high -pix_fmt yuv420p)
      fi
      if [[ -z $acodec || $acodec == aac ]]; then aargs=(-c:a copy); else aargs=(-c:a aac -b:a 160k); fi
      # Encode beside the target and rename only on success: a failed or
      # interrupted encode must not leave a partial -share.mp4 that a later
      # Copy would take as finished. (.mp4 suffix: ffmpeg picks the muxer by it.)
      tmp="$dir/.${base}-share.$$.mp4"
      trap 'rm -f "$tmp"' EXIT
      ffmpeg -hide_banner -loglevel error -y -i "$file" -map 0:v:0 -map '0:a:0?' \
        "${vargs[@]}" "${aargs[@]}" -movflags +faststart "$tmp" && mv -f "$tmp" "$out"
      echo "$out"; exit 0
    fi
    case "$quality" in
      4k)    scale="3840:-2" ;;
      1080p) scale="1920:-2" ;;
      720p)  scale="1280:-2" ;;
      *)     scale="1920:-2" ;;
    esac
    ffmpeg -hide_banner -loglevel error -y -i "$file" \
      -vf "scale=${scale}:flags=lanczos" \
      -c:v libx264 -preset slow -crf 21 -pix_fmt yuv420p \
      -c:a aac -b:a 160k "$out"
    ;;

  gif)
    case "$quality" in
      1080p) width=1080 ;;
      720p)  width=720 ;;
      *)     width=800 ;;
    esac
    if command -v gifski >/dev/null 2>&1; then
      # gifski gives noticeably better GIFs than ffmpeg's palettegen.
      tmp=$(mktemp -d)
      trap 'rm -rf "$tmp"' EXIT
      ffmpeg -hide_banner -loglevel error -y -i "$file" \
        -vf "fps=15,scale=${width}:-2:flags=lanczos" "$tmp/frame%05d.png"
      gifski --quiet -o "$out" --fps 15 "$tmp"/frame*.png
    else
      ffmpeg -hide_banner -loglevel error -y -i "$file" \
        -vf "fps=15,scale=${width}:-2:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse" \
        "$out"
    fi
    ;;

  jpg|jpeg)
    case "$quality" in
      low)    q=60 ;;
      medium) q=80 ;;
      high|*) q=92 ;;
    esac
    magick "$file" -quality "$q" -strip "$out"
    ;;

  png)
    magick "$file" -strip "$out"
    ;;

  *)
    echo "Unknown format: $format (want mp4|gif|jpg|png)"; exit 1 ;;
esac

echo "$out"
