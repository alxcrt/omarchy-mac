#!/bin/bash
# ghostty-run [command...]
# Open a new window in the already-running Ghostty, in the current directory,
# and optionally run <command...> in it through your normal shell (as if
# typed, so the shell stays open after the command exits).
#
# Ghostty's own AppleScript does this: `new window with configuration`, whose
# `initial input` is fed to the new terminal. The previous version faked it:
# ⌘N and the command typed through System Events (needs Accessibility, and the
# keystrokes went to whichever app had focus a moment later), after waiting
# ~3s for AeroSpace, which is gone. `open -na Ghostty --args -e cmd` is not an
# option either: -n starts a second Ghostty application with its own Dock icon.
set -uo pipefail

input=""
(($# > 0)) && input="$*"$'\n'

osascript - "$PWD" "$input" >/dev/null <<'AS'
on run argv
  -- Ghostty's record keys only parse inside its tell block.
  tell application "Ghostty"
    set cfg to {initial working directory:(item 1 of argv)}
    if (item 2 of argv) is not "" then set cfg to cfg & {initial input:(item 2 of argv)}
    new window with configuration cfg
    activate
  end tell
end run
AS
