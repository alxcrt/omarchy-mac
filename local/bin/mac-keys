#!/bin/bash
# mac-keys — print every keybinding in this setup, read from the live configs
# so it can never drift from reality. Omarchy's Super+K equivalent.
#
#   mac-keys            pretty listing
#   mac-keys --md       markdown (used to regenerate KEYBINDINGS.md)
set -e

MD=0; [ "$1" = "--md" ] && MD=1
A=~/.config/aerospace/aerospace.toml
T=~/.config/tmux/tmux.conf
G=~/.config/ghostty/config
K=~/.config/karabiner/karabiner.json
E=~/.config/omarchy-mac/extensions

# Render an aerospace key token as the keys you actually press.
pretty() {
  python3 - "$1" <<'PY'
import sys
k = sys.argv[1]
parts = k.split('-')
mods, key = [], []
names = {'ctrl':'⌃','alt':'⌥','shift':'⇧','cmd':'⌘'}
for p in parts:
    (mods if p in names else key).append(p)
keyname = '-'.join(key)
keyname = {'enter':'Enter','tab':'Tab','slash':'/','minus':'-','equal':'=',
           'left':'←','right':'→','up':'↑','down':'↓','esc':'Esc',
           'backspace':'⌫','space':'Space'}.get(keyname, keyname.upper())
mset = set(mods)
# ctrl+alt+cmd is SUPER (Caps Lock)
if {'ctrl','alt','cmd'} <= mset:
    rest = mset - {'ctrl','alt','cmd'}
    pre = 'Caps' + ('+⇧' if 'shift' in rest else '')
    print(f"{pre}+{keyname}")
else:
    print(''.join(names[m] for m in ['ctrl','alt','shift','cmd'] if m in mset) + keyname)
PY
}

section() { if [ $MD = 1 ]; then printf '\n## %s\n\n| Keys | Action |\n|---|---|\n' "$1"; else printf '\n\033[1m%s\033[0m\n' "$1"; fi; }
row()     { if [ $MD = 1 ]; then printf '| `%s` | %s |\n' "$1" "$2"; else printf '  %-22s %s\n' "$1" "$2"; fi; }

[ $MD = 1 ] && printf '# Keybindings\n\nGenerated by `mac-keys --md` from the live configs — do not hand-edit.\n\n**SUPER = Caps Lock** (Karabiner maps it to `⌃⌥⌘`; tap alone = Escape).\n'

section "Karabiner (modifier layer)"
row "Caps Lock (hold)" "SUPER — the modifier every window binding below uses"
row "Caps Lock (tap)" "Escape"
row "Right ⌘" "second SUPER key"

# ---- AeroSpace ----
render_aero() {
  local mode="$1" title="$2"
  section "$title"
  awk -v m="$mode" '
    $0 ~ "^\\[mode\\."m"\\.binding\\]" {on=1; next}
    /^\[/ {on=0}
    on && /^[a-z0-9-]+ *=/ {print}
  ' "$A" | while IFS= read -r line; do
    key=${line%%=*}; key=$(echo "$key" | tr -d ' ')
    cmd=${line#*=}
    # strip quotes and trailing comment
    desc=$(printf '%s' "$cmd" | sed "s/^ *'''//; s/^ *'//; s/' *#/ #/; s/'\{1,3\} *$//" | sed 's/ *#.*//' | sed 's/^ *//')
    note=$(printf '%s' "$line" | sed -n 's/.*# *//p')
    [ -n "$note" ] && desc="$note"
    # humanise the common exec commands
    desc=$(printf '%s' "$desc" \
      | sed "s/exec-and-forget ghostty-run /run in new terminal: /" \
      | sed "s/exec-and-forget open -a /open app: /" \
      | sed "s/.*Sound-Settings.*/System Settings: Sound/" \
      | sed "s/.*BluetoothSettings.*/System Settings: Bluetooth/" \
      | sed "s/.*wifi-settings.*/System Settings: Wi-Fi/" \
      | sed "s/.*Displays-Settings.*/System Settings: Displays/" \
      | sed "s/.*Battery-Settings.*/System Settings: Battery/" \
      | sed "s/exec-and-forget osascript.*incognito.*/new Chrome incognito window/" \
      | sed "s/exec-and-forget osascript.*Ghostty.*/new Ghostty window/" \
      | sed "s/exec-and-forget osascript.*Chrome.*/new Chrome window/" \
      | sed "s/exec-and-forget pmset displaysleepnow/lock screen/" \
      | sed "s/move-node-to-workspace \\([0-9]*\\) --focus-follows-window/send window to workspace \\1 (and follow)/" \
      | sed "s/move-node-to-workspace \\([0-9]*\\)$/send window to workspace \\1 (stay)/" \
      | sed "s/^workspace \\([0-9]*\\)$/switch to workspace \\1/" \
      | sed "s/^workspace next/next workspace/; s/^workspace prev/previous workspace/" \
      | sed "s/^workspace-back-and-forth/former workspace/" \
      | sed "s/^resize smart -\\(.*\\)/shrink window (\\1)/; s/^resize smart +\\(.*\\)/grow window (\\1)/" \
      | sed "s/^resize width -\\(.*\\)/narrower (\\1)/; s/^resize width +\\(.*\\)/wider (\\1)/" \
      | sed "s/^resize height -\\(.*\\)/shorter (\\1)/; s/^resize height +\\(.*\\)/taller (\\1)/" \
      | sed "s/^focus \\(.*\\)/focus window \\1/" \
      | sed "s/^move \\(.*\\)/move window \\1/" \
      | sed "s/^mode resize/enter resize mode/; s/^mode main/leave resize mode/" \
      | sed "s/^reload-config/reload AeroSpace config/" \
      | sed "s/^close-all-windows-but-current/close all other windows/" \
      | sed "s/^close$/close window/" \
      | sed "s/^fullscreen/fullscreen/" \
      | sed "s/ (moved off.*)//" \
      | sed "s/exec-and-forget //")
    row "$(pretty "$key")" "$desc"
  done
}
render_aero main "Window management (AeroSpace)"
render_aero resize "Resize mode (enter with Caps+R)"

section "Browser extensions (inside Chrome)"
for d in "$E"/*/; do
  [ -f "$d/manifest.json" ] || continue
  python3 - "$d" <<'PY'
import json,sys,os
m=json.load(open(os.path.join(sys.argv[1],"manifest.json")))
for c in (m.get("commands") or {}).values():
    k=c.get("suggested_key",{}).get("default")
    if k: print(f"{k}\t{c.get('description', m['name'])}")
PY
done | while IFS=$'\t' read -r k d; do row "$k" "$d"; done

section "tmux (prefix = Ctrl+Space, also Ctrl+B)"
grep -E '^bind ' "$T" | while IFS= read -r l; do
  desc=$(printf '%s' "$l" | sed -n 's/^bind -N "\([^"]*\)".*/\1/p')
  keys=$(printf '%s' "$l" | sed 's/^bind -N "[^"]*" *//; s/^bind *//' | awk '{if($1=="-n"){print $2" (no prefix)"} else if($1=="-T"){print $3" ("$2" mode)"} else print "prefix "$1}')
  [ -n "$desc" ] && row "$keys" "$desc"
done

section "Ghostty (inside the terminal)"
grep -E '^keybind' "$G" | while IFS= read -r l; do
  spec=${l#*= }; k=${spec%%=*}; a=${spec#*=}
  k=${k#performable:}; k=${k#global:}
  row "$(printf '%s' "$k" | sed 's/opt+/⌥/; s/ctrl+/⌃/g; s/shift+/⇧/g; s/cmd+/⌘/g')" "$a"
done

[ $MD = 0 ] && printf '\n(regenerate the repo doc with: mac-keys --md > ~/omarchy-mac/KEYBINDINGS.md)\n'
