#!/bin/bash
# mac-notify — post a notification about a file; clicking it acts on the file.
#
#   mac-notify <title> <message> [file]
#   mac-notify --copy <file>          (what a MAC_NOTIFY_CLICK=copy click runs)
#
#   MAC_NOTIFY_CLICK=copy    clicking puts a share-ready copy of FILE on the
#                            clipboard (mac-clip --share: H.264/AAC for chat
#                            apps), then confirms with a notification whose
#                            click shows the copy in Finder.
#                            Default (show): clicking shows FILE in Finder.
#   MAC_NOTIFY_GROUP=<id>    replace the previous notification in <id>
#   MAC_NOTIFY_IMAGE=<path>  thumbnail (image files get one automatically)
#
# Why clicks, not buttons: an -action button needs a terminal-notifier process
# waiting for the answer, and with two such notifications pending macOS hands
# the click to whichever process it likes. Pressing Copy on one notification
# copied ANOTHER download (seen Oct 2026). An -execute click command is stored
# in the notification itself, so it works for any number of them, even after
# a reboot, with nothing left running.
#
# osascript's `display notification` is not used: it is posted as Script
# Editor and cannot carry a click action, so clicking one opens Script Editor.

tn=${MAC_NOTIFY_BIN:-/opt/homebrew/bin/terminal-notifier}   # override: tests
self="$HOME/.local/bin/mac-notify"

if [ "${1:-}" = --copy ]; then
  # Runs from a notification click, under launchd's bare PATH: put back what
  # mac-clip --share needs (transcode -> ffmpeg/ffprobe).
  export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  file=${2:?usage: mac-notify --copy <file>}
  export MAC_NOTIFY_GROUP="mac-clip-$$"; unset MAC_NOTIFY_CLICK MAC_NOTIFY_IMAGE
  "$self" "Preparing to share…" "$(basename "$file")"
  if shared=$(mac-clip --share "$file"); then
    "$self" "Copied · ready to paste" "$(basename "$shared") — click to show in Finder" "$shared"
  else
    "$self" "Copy failed" "$(basename "$file")"
    exit 1
  fi
  exit 0
fi

title=${1:?usage: mac-notify <title> <message> [file]} msg=${2:-} file=${3:-}

if [ ! -x "$tn" ]; then
  # Fallback: no click action, but at least the notification shows. Strings go
  # in as argv, never into AppleScript source, so quotes in a URL can't break it.
  exec osascript -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
    -e 'end run' "$title" "$msg"
fi

# terminal-notifier reads a message that starts with - or [ as an option.
case $msg in -*|\[*) msg="\\$msg" ;; esac
args=(-title "$title" -message "$msg")
# Same group = the new notification replaces the old one (webdl's
# "Downloading…" is replaced by "Download complete" instead of stacking).
[ -n "${MAC_NOTIFY_GROUP:-}" ] && args+=(-group "$MAC_NOTIFY_GROUP")
[ -n "${MAC_NOTIFY_IMAGE:-}" ] && [ -f "$MAC_NOTIFY_IMAGE" ] && args+=(-contentImage "$MAC_NOTIFY_IMAGE")

[ -n "$file" ] && [ -e "$file" ] || exec "$tn" "${args[@]}"

case $file in
  *.[jJ][pP][gG]|*.[jJ][pP][eE][gG]|*.[pP][nN][gG]|*.[gG][iI][fF]|*.[hH][eE][iI][cC])
    args+=(-contentImage "$file") ;;   # an image result is its own thumbnail
esac

# The click command runs through sh -c, so every word is shell-quoted.
if [ "${MAC_NOTIFY_CLICK:-show}" = copy ]; then
  click="$(printf '%q' "$self") --copy $(printf '%q' "$file")"
else
  click="open -R $(printf '%q' "$file")"
fi
exec "$tn" "${args[@]}" -execute "$click"
