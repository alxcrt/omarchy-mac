#!/bin/bash
# webdl [url] — download the video on the current browser page.
# Port of Omarchy's bin/omarchy-chromium-ytdlp-host (the Alt+Shift+D flow).
#
# Omarchy drives this from a Chromium extension via native messaging; on macOS
# we get the URL from the frontmost tab with AppleScript instead. The yt-dlp
# invocation itself mirrors Omarchy's:
#   --no-playlist --restrict-filenames, a --simulate pre-flight check,
#   --paths <dir>, and '%(title)s [%(id)s].%(ext)s' naming.
#
# Destination follows Omarchy's OMARCHY_YTDLP_DIR override; the default is
# ~/Movies rather than ~/Videos, because that's the macOS equivalent folder.
set -euo pipefail

DOWNLOAD_DIR="${OMARCHY_YTDLP_DIR:-$HOME/Movies}"

url=${1:-}
[[ -z $url ]] && url=$(browser-url 2>/dev/null || true)
[[ -z $url ]] && { echo "No URL (pass one, or focus a browser tab)" >&2; exit 1; }
[[ $url =~ ^https?:// ]] || { echo "Not an http(s) URL: $url" >&2; exit 1; }

# yt-dlp's cookie backend for whichever browser is in use. Omarchy doesn't need
# this (its extension runs inside the authenticated session); driving the
# browser from outside, we pass cookies so logged-in/age-gated videos work.
case "${OMARCHY_BROWSER:-Google Chrome}" in
  Chromium)        cookie_browser=chromium ;;
  "Brave Browser") cookie_browser=brave ;;
  Vivaldi)         cookie_browser=vivaldi ;;
  *)               cookie_browser=chrome ;;
esac

# notify <title> <message> [file] — clicking it reveals the file (mac-notify).
# One group per run, so each notification replaces this run's previous one.
notify() {
  MAC_NOTIFY_GROUP="webdl-$$" "$HOME/.local/bin/mac-notify" "$@" || echo "notify failed (rc=$?)" >&2
}

# Every exit says how it went: webdl is the only one reporting the outcome
# (the browser extension shows progress only), so an early failure, such as
# a download folder that can't be created, must not exit silently. A kill
# (below) or an outcome already posted counts as reported.
reported=0
out=""; thumbdir=""
trap 'rc=$?; rm -rf "$out" "$thumbdir"; [ $rc -ne 0 ] && [ $reported = 0 ] && notify "Download failed" "${title:-$url}"' EXIT
mkdir -p "$DOWNLOAD_DIR"
out=$(mktemp); thumbdir=$(mktemp -d)
# If this run is killed (the browser's native host stops it when the extension
# disconnects), take its "Downloading…" notification down with it.
# The download runs as a background job (below) so this fires at once — bash
# defers traps while a foreground pipeline runs. It stops the whole tree
# (yt-dlp's ffmpeg downloader/postprocessor are grandchildren), and every step
# is best-effort: with no children left, a failing pkill under set -e would
# otherwise end the handler before the notification is removed.
killtree() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done; kill -TERM "$1" 2>/dev/null || true; }
trap 'reported=1; for c in $(pgrep -P $$ 2>/dev/null); do killtree "$c"; done; "${MAC_NOTIFY_BIN:-/opt/homebrew/bin/terminal-notifier}" -remove "webdl-$$" >/dev/null 2>&1 || true; exit 130' INT TERM HUP

# probe [yt-dlp args] — print "<id><TAB><title>" of the video at $url.
# Check for an ID, not just the exit code: on a page with no video (the
# YouTube homepage) yt-dlp finds nothing and still exits 0.
probe() {
  yt-dlp --no-playlist --playlist-items 1 --simulate --quiet --no-warnings \
    --print '%(id)s	%(title)s' "$@" "$url" 2>/dev/null | head -1
}

# Like Omarchy: don't show anything until yt-dlp confirms there's a video here.
# Cookies are a bonus, not a requirement: when the browser's cookie store can't
# be read (no profile at the expected path, Keychain access denied), yt-dlp
# aborts outright — retry without them so public videos still download.
# (${cookies[@]+...}: bash 3.2 under set -u rejects an empty "${cookies[@]}".)
cookies=(--cookies-from-browser "$cookie_browser")
found=$(probe "${cookies[@]}" || true)
if [[ -z $found ]]; then
  found=$(probe || true)
  [[ -n $found ]] && cookies=()
fi
if [[ -z $found ]]; then
  reported=1; notify "No video found for download" "$url"
  echo "No video found for download: $url" >&2
  exit 0
fi
title=${found#*$'\t'}

echo "→ $url"
notify "Downloading…" "$title"

# --print after_move only fires on a successful download+move, so a captured
# path means success — same success signal Omarchy uses.
# PROGRESS lines go to stdout so a caller (the browser native host) can stream
# them live; --newline keeps them one per line instead of \r-overwriting.
# --playlist-items 1: a channel or playlist page must not pull dozens of videos.
# `|| true`: under pipefail a yt-dlp error would exit right here, before the
# failure notification, leaving "Downloading…" up forever.
yt-dlp \
  --no-playlist --playlist-items 1 \
  --restrict-filenames \
  ${cookies[@]+"${cookies[@]}"} \
  --merge-output-format mp4 \
  --paths "$DOWNLOAD_DIR" \
  -o '%(title)s [%(id)s].%(ext)s' \
  --print 'after_move:%(filepath)s' \
  --newline --progress-template 'download:PROGRESS %(progress._percent_str)s' \
  --no-simulate --quiet --no-warnings --progress \
  "$url" | tee "$out" &
wait $! || true
filepath=$(grep -v '^PROGRESS' "$out" | tail -1 || true)

if [[ -n ${filepath:-} && -f $filepath ]]; then
  # A frame from the video as the notification's thumbnail.
  thumb="$thumbdir/thumb.jpg"
  ffmpeg -loglevel error -y -ss 1 -i "$filepath" -frames:v 1 -vf scale=480:-2 "$thumb" 2>/dev/null || thumb=
  # Clicking it puts a share-ready copy on the clipboard (H.264/AAC for chat
  # apps); the "Copied" confirmation's click shows it in Finder. See
  # mac-notify for why this is a click and not buttons.
  reported=1; MAC_NOTIFY_CLICK=copy MAC_NOTIFY_IMAGE=$thumb notify "Download complete" "$title — click to copy" "$filepath"
  echo "$filepath"
else
  reported=1; notify "Download failed" "$title"
  exit 1
fi
