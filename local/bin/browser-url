#!/bin/bash
# browser-url — print the selected Chromium-family browser's current tab URL.
# Shared by `weburl` and `webdl`; prefer the default browser when it is running.
#
# Omarchy uses Chromium on Arch; on macOS the same flow works with Chrome,
# Helium, Chromium, Brave or Vivaldi — they speak the same AppleScript dialect.
# Override the choice with:  export OMARCHY_BROWSER="Brave Browser"
set -e

candidates=("Helium" "Google Chrome" "Chromium" "Brave Browser" "Vivaldi")
if [[ -n ${OMARCHY_BROWSER:-} ]]; then
  candidates=("$OMARCHY_BROWSER")
else
  # Read Launch Services without launching a browser or requiring Accessibility.
  preferred=$(/opt/homebrew/bin/python3 - <<'PY' 2>/dev/null || true
from pathlib import Path
import plistlib
p = Path.home() / 'Library/Preferences/com.apple.LaunchServices/com.apple.launchservices.secure.plist'
names = {'net.imput.helium': 'Helium', 'com.google.chrome': 'Google Chrome',
         'org.chromium.chromium': 'Chromium', 'com.brave.browser': 'Brave Browser',
         'com.vivaldi.vivaldi': 'Vivaldi'}
if p.exists():
    handlers = plistlib.loads(p.read_bytes()).get('LSHandlers', [])
    for scheme in ('https', 'http'):
        for h in handlers:
            if h.get('LSHandlerURLScheme') == scheme:
                name = names.get(h.get('LSHandlerRoleAll', '').lower())
                if name:
                    print(name)
                    raise SystemExit
PY
  )
  if [[ -n $preferred ]]; then
    ordered=("$preferred")
    for candidate in "${candidates[@]}"; do
      [[ $candidate = "$preferred" ]] || ordered+=("$candidate")
    done
    candidates=("${ordered[@]}")
  fi
fi

# Prefer a browser that is actually running, so the "front window" is real.
for app in "${candidates[@]}"; do
  [[ -d "${OMARCHY_BROWSER_APPLICATIONS_DIR:-/Applications}/$app.app" ]] || continue
  # OMARCHY_BROWSER is data, even when the app's name contains quotes.
  escaped=${app//\\/\\\\}; escaped=${escaped//\"/\\\"}
  running=$(osascript -e "application \"$escaped\" is running" 2>/dev/null || echo false)
  [[ $running == true ]] || continue
  url=$(osascript -e "tell application \"$escaped\" to return URL of active tab of front window" 2>/dev/null || true)
  if [[ -n $url ]]; then
    printf '%s' "$url"
    exit 0
  fi
done

echo "No Chromium-family browser with an open tab (tried: ${candidates[*]})" >&2
exit 1
