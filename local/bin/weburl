#!/bin/bash
# weburl — copy the frontmost Chrome tab's URL to the clipboard.
# macOS port of Omarchy's Alt+Shift+L flow (pbcopy stands in for wl-copy).
set -e

url=$(osascript -e 'tell application "Google Chrome" to return URL of active tab of front window' 2>/dev/null || true)
[[ -z $url ]] && { echo "No Chrome window/tab in front"; exit 1; }

printf '%s' "$url" | pbcopy
osascript -e "display notification \"$url\" with title \"Copied URL\"" >/dev/null 2>&1 || true
echo "$url"
