#!/bin/bash
# weburl — copy the frontmost browser tab's URL to the clipboard.
# macOS port of Omarchy's Alt+Shift+L flow (pbcopy stands in for wl-copy).
set -e

url=$(browser-url) || exit 1
printf '%s' "$url" | pbcopy
osascript \
  -e 'on run argv' \
  -e 'display notification (item 1 of argv) with title "Copied URL"' \
  -e 'end run' \
  "$url" || echo "notify failed (rc=$?)" >&2
echo "$url"
