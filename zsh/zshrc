# ~/.zshrc — Omarchy's shell layer (basecamp/omarchy default/bash/*), in zsh.
#
# No oh-my-zsh: it cost ~20ms of startup for features this file sets directly.
# Upstream's bash layer is rc -> envs, shell, aliases, functions, init, inputrc;
# the same pieces are below, in the same order. Startup budget: test.sh's
# `shell` section fails if an interactive shell takes over 100ms.

# ── shell (upstream default/bash/shell) ────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=32768
SAVEHIST=32768
setopt share_history extended_history hist_verify
setopt hist_ignore_all_dups   # upstream HISTCONTROL=ignoreboth
setopt hist_ignore_space
setopt interactive_comments auto_cd auto_pushd pushd_ignore_dups
unsetopt hash_cmds hash_dirs  # upstream `set +h` — stops stale mise shim paths

# ── completion ─────────────────────────────────────────────────────────────
# Full compinit security scan at most once a day; otherwise trust the dump
# (-C) and load its zcompiled copy.
_zcache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $_zcache ]] || mkdir -p $_zcache
autoload -Uz compinit
# The glob qualifier must sit in an array assignment: [[ ]] never expands
# globs, so `[[ -n file(N.mh+24) ]]` is always true and would audit every time.
_zstale=( $_zcache/zcompdump(N.mh+24) )
if (( $#_zstale )) || [[ ! -s $_zcache/zcompdump ]]; then
  compinit -d $_zcache/zcompdump
else
  compinit -C -d $_zcache/zcompdump
fi
[[ $_zcache/zcompdump.zwc -nt $_zcache/zcompdump ]] || zcompile $_zcache/zcompdump
# upstream inputrc: completion-ignore-case, colored-stats
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors ''
zstyle ':completion:*' menu select

# ── keys (upstream default/bash/inputrc) ───────────────────────────────────
bindkey -e
# ↑/↓ search history for lines starting with what is already typed
bindkey '^[[A' history-beginning-search-backward '^[OA' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward  '^[OB' history-beginning-search-forward
bindkey '^[[H' beginning-of-line '^[[F' end-of-line '^[[3~' delete-char
bindkey '^[[1;5C' forward-word '^[[1;5D' backward-word   # ⌃→ / ⌃←
bindkey '^[[1;3C' forward-word '^[[1;3D' backward-word   # ⌥→ / ⌥←

# ── init (upstream default/bash/init) ──────────────────────────────────────
# mise stays a live eval: its activate script hard-codes the PATH of the
# moment it was generated, so a cached copy would go stale.
eval "$(/opt/homebrew/bin/mise activate zsh)"

# APPEND, don't prepend: mise activate (above) puts its tool paths at the front,
# and prepending here would outrank them — `mise doctor` flags exactly that.
# Upstream Omarchy appends for the same reason.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$PATH:$HOME/.local/bin" ;;
esac

source ~/.config/zsh/aliases.zsh
source ~/.config/zsh/functions.zsh

# zoxide and starship print the same static script on every start, so cache
# it; regenerate when the binary (or starship.toml) is newer than the cache.
# Absolute paths: with hash_cmds off, every $commands lookup searches PATH.
_zoxide=/opt/homebrew/bin/zoxide
if [[ -x $_zoxide ]]; then
  [[ -s $_zcache/zoxide.zsh && $_zcache/zoxide.zsh -nt $_zoxide ]] ||
    $_zoxide init zsh >| $_zcache/zoxide.zsh
  # `cd` is aliased to the zd() wrapper in aliases.zsh (matching Omarchy) —
  # do not re-alias it to plain `z` here, that would shadow the wrapper.
  source $_zcache/zoxide.zsh
fi

# starship's init also starts starship once for PROMPT2 and sets an RPROMPT
# that starts a second starship on EVERY prompt (~9ms per Enter). Omarchy's
# starship.toml has no right side, so that process only ever prints nothing.
# Bake PROMPT2 in once, and keep RPROMPT only if it would render something.
_starship=/opt/homebrew/bin/starship
_starship_cfg=${STARSHIP_CONFIG:-$HOME/.config/starship.toml}
if [[ -x $_starship ]]; then
  _f=$_zcache/starship.zsh
  if [[ ! -s $_f || $_starship -nt $_f || $_starship_cfg -nt $_f ]]; then
    {
      $_starship init zsh --print-full-init | grep -v -e '^RPROMPT=' -e '^PROMPT2='
      # STARSHIP_SHELL=zsh makes starship wrap escapes in %{ %}, as its own
      # init does; without it zsh miscounts the prompt width.
      print -r -- "PROMPT2=${(qq)$(STARSHIP_SHELL=zsh $_starship prompt --continuation)}"
      [[ -n $(STARSHIP_SHELL=zsh $_starship prompt --right) ]] &&
        $_starship init zsh --print-full-init | grep '^RPROMPT='
    } >| $_f
  fi
  source $_f
fi

# Only fzf's key bindings (Ctrl-R, Ctrl-T, Alt-C), like upstream: sourced from
# the formula's own file, so no `fzf --zsh` process at startup.
[[ -r /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh

# try (tobi/try): lazy, like upstream — its init only runs on first use.
# Upstream keeps tries in ~/Work/tries; on macOS they live under ~/Developer.
if [[ -x /opt/homebrew/bin/try ]]; then
  try() {
    unfunction try
    eval "$(SHELL=/bin/zsh command try init ~/Developer/tries)"
    try "$@"
  }
fi

# Machine-local additions (not tracked in the repo): PATH entries, ssh-add,
# work-specific aliases. Keep anything host-specific there, not here.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
